{
  "name": "Verified main changes",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Workflow locks and security",
            "integration_id": 15368
          },
          {
            "context": "Build release candidate",
            "integration_id": 15368
          },
          {
            "context": "CodeQL",
            "integration_id": 57789
          },
          {
            "context": "Offline CLI tests (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "Offline CLI tests (macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "Offline CLI tests (windows-latest)",
            "integration_id": 15368
          },
          {
            "context": "Buf binding proof (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "Buf binding proof (macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "Buf binding proof (windows-latest)",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    }
  ]
}

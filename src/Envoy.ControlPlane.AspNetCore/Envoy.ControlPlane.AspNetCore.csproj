<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Knightfall.Envoy.ControlPlane.AspNetCore</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>ASP.NET Core hosting for Envoy SotW/Delta discovery, unary Fetch and an optional HTTP gateway.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Envoy.ControlPlane/Envoy.ControlPlane.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

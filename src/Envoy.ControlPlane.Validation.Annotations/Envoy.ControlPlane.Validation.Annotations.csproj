<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Knightfall.Envoy.ControlPlane.Validation.Annotations</PackageId>
    <Description>Single-owner Protovalidate annotation and violation contracts for Envoy.ControlPlane.</Description>
    <Authors>knightfall</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/knightfall/envoy-dotnet-control-plane</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <Compile Include="obj/generated/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="obj/inputs/buf/validate/validate.proto" Pack="true" PackagePath="schemas/buf/validate/" />
    <None Include="obj/LICENSE.upstream" Pack="true" PackagePath="licenses/" />
    <None Include="../../schemas/validation/sources.lock.json" Pack="true" PackagePath="schemas/" />
  </ItemGroup>
  <Target Name="RequireGeneratedAnnotations" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('obj/generated/Buf/Validate/Validate.cs')" Text="Run dotnet run --project tools/Envoy.ControlPlane.Tools -- bindings generate --cache &lt;external-source-cache&gt; before building annotation contracts." />
  </Target>
</Project>

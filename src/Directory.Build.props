<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Version>1.0.0-rc.1</Version>
    <Authors>knightfall</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/knightfall/envoy-dotnet-control-plane</RepositoryUrl>
    <PackageProjectUrl>https://github.com/knightfall/envoy-dotnet-control-plane</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/knightfall/envoy-dotnet-control-plane/releases/tag/v$(Version)</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="licenses/" />
    <None Include="../../docs/releases/provenance.json" Pack="true" PackagePath="security/" />
  </ItemGroup>
</Project>

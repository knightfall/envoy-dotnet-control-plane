    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Envoy control-plane snapshots, SotW/Delta caches and streams, Fetch, client and resource helpers.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Envoy.ControlPlane.Protocol/Envoy.ControlPlane.Protocol.csproj" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../Envoy.ControlPlane.Protocol/obj/upstream/licenses/go-control-plane/LICENSE" Pack="true" PackagePath="licenses/upstream/" />
  </ItemGroup>
</Project>

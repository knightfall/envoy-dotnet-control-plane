<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Envoy.ControlPlane.Protocol/Envoy.ControlPlane.Protocol.csproj" />
    <PackageReference Include="ProtoValidate" GeneratePathProperty="true" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <Compile Include="../Support/*.cs" Link="Support/%(Filename)%(Extension)" />
    <None Include="$(PkgProtoValidate)/content/proto/buf/validate/validate.proto"
          Link="proto/buf/validate/validate.proto" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

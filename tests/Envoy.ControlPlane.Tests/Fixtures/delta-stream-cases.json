      },
      {
        "kind": "request",
        "type": "B",
        "add": [
          "dir/*"
        ]
      },
      {
        "kind": "end"
      }
    ],
    "expected": {
      "events": [
        "open|",
        "request|A|||||false",
        "watch|A||||false",
        "request|B|||dir/*||false",
        "watch|B||dir/||false",
        "close|"
      ],
      "disposals": [
        1,
        1
      ]
    }
  },
  {
    "id": "response-callback-can-change-nonce",
    "defaultType": "A",
    "callbackNonce": "callback-token",
    "steps": [
      {
        "kind": "request",
        "type": "",
        "add": [
          "a"
        ]
      },
      {
        "kind": "respond",
        "watch": 0,
        "version": "v",
        "names": [
          "a"
        ]
      },
      {
        "kind": "request",
        "type": "",
        "nonce": "callback-token"
      },
      {
        "kind": "end"
      }

  {
    "id": "callback-mutation-and-receive-error",
    "defaultType": "A",
    "mutate": true,
    "steps": [
      {
        "kind": "request",
        "type": "mutate"
      },
      {
        "kind": "request",
        "type": ""
      },
      {
        "kind": "end",
        "receiveError": true
      }
    ],
    "expected": {
      "events": [
        "open|A",
        "request|mutate|||||false",
        "watch|changed|selected|||false",
        "request||||||false",
        "watch|A||||true",
        "close|callback"
      ],
      "disposals": [
        1,
        1
      ]
    }
  }
]

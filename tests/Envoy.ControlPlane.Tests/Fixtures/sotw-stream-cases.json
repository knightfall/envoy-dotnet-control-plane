        "open|",
        "request|custom/A||||old|false",
        "watch|custom/A||old||false",
        "request|custom/B|||||false",
        "watch|custom/B||||true",
        "request|custom/A||||new|false",
        "response|custom/B|vb|1",
        "send|custom/B|vb|1",
        "watch|custom/A||new||false",
        "response|custom/A|new|2",
        "send|custom/A|new|2",
        "close|"
      ],
      "disposals": [
        1,
        1,
        1
      ]
    }
  },

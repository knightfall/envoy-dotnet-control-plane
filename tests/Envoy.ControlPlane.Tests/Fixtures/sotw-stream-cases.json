        "hold": true
      },
      {
        "kind": "queue",
        "watch": 0,
        "version": "old",
        "names": [
          "old"
        ]
      },
      {
        "kind": "queue",
        "watch": 1,
        "version": "vb",
        "names": [
          "b"
        ]
      },
      {
        "kind": "release",
        "sent": 1
      },
      {
        "kind": "respond",
        "watch": 2,
        "version": "new",
        "names": [
          "new"
        ]
      },
      {
        "kind": "end"

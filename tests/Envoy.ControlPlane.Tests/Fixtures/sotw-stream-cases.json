[
  {
    "id": "node-and-implied-types",
    "defaultType": "type/A",
    "steps": [
      {
        "kind": "request",
        "node": "first"
      },
      {
        "kind": "request"
      },
      {
        "kind": "request",
        "type": "type/B",
        "node": "later",
        "version": "x"
      },
      {
        "kind": "end"
      }
    ],
    "expected": {
      "events": [
        "open|type/A",
        "request|type/A|first||||false",
        "watch|type/A||||true",
        "request|type/A|first||||false",
        "watch|type/A||||true",
        "request|type/B|later|x|||false",
        "watch|type/B|x|||true",
        "close|later"
      ],
      "disposals": [
        1,
        1,
        1
      ]
    }
  },
  {
    "id": "stale-and-current-watch-nonces",
    "defaultType": "type/A",
    "steps": [
      {
        "kind": "request",
        "names": [
          "a"
        ]
      },
      {
        "kind": "respond",
        "watch": 0,
        "version": "v1",
        "names": [
          "a"
        ]
      },
      {
        "kind": "request",
        "node": "stale",
        "nonce": "old",
        "names": [
          "ignored"
        ],
        "stale": true
      },
      {
        "kind": "request",
        "nonce": "1",
        "version": "v1",
        "names": [
          "a"
        ]
      },
      {
        "kind": "request",
        "nonce": "unrelated",
        "version": "v1",
        "names": [
          "b"
        ]
      },
      {
        "kind": "end"
      }
    ],
    "expected": {
      "events": [
        "open|type/A",
        "request|type/A||||a|false",
        "watch|type/A||a||false",
        "response|type/A|v1|1",
        "send|type/A|v1|1",
        "request|type/A|stale||old|ignored|false",
        "request|type/A|stale|v1|1|a|false",
        "watch|type/A|v1|a|a=v1|false",
        "request|type/A|stale|v1|unrelated|b|false",
        "watch|type/A|v1|b||false",
        "close|stale"
      ],
      "disposals": [
        1,
        1,
        1
      ]
    }
  },

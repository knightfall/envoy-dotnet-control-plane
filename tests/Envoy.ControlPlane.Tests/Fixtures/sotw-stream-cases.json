        "request|type/A|client|old|1|a|true",
        "watch|type/A|old|a|a=new|false",
        "response|type/A|new|2",
        "send|type/A|new|2",
        "close|client"
      ],
      "disposals": [
        1,
        1
      ]
    }
  },

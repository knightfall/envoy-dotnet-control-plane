  {
    "id": "ordered-buffered-producer-order",
    "defaultType": "",
    "ordered": true,
    "steps": [
      {
        "kind": "request",
        "type": "custom/A"
      },
      {
        "kind": "request",
        "type": "custom/B"
      },
      {
        "kind": "request",
        "type": "gate",
        "hold": true
      },
      {
        "kind": "queue",
        "watch": 1,
        "version": "vb",
        "names": [
          "b"
        ]
      },
      {
        "kind": "queue",
        "watch": 0,
        "version": "va",
        "names": [
          "a"
        ]
      },
      {
        "kind": "release",
        "sent": 2
      },
      {
        "kind": "end"
      }
    ],
    "expected": {
      "events": [
        "open|",
        "request|custom/A|||||false",
        "watch|custom/A||||true",
        "request|custom/B|||||false",
        "watch|custom/B||||true",
        "request|gate|||||false",
        "watch|gate||||true",
        "response|custom/B|vb|1",
        "send|custom/B|vb|1",
        "response|custom/A|va|2",
        "send|custom/A|va|2",
        "close|"
      ],
      "disposals": [
        1,
        1,
        1
      ]
    }
  },

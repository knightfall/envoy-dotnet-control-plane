<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Envoy.ControlPlane/Envoy.ControlPlane.csproj" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <EmbeddedResource Include="Fixtures/sotw-subscription-cases.json" LogicalName="Envoy.ControlPlane.Tests.SotwCases.json" />
    <EmbeddedResource Include="Fixtures/delta-subscription-cases.json" LogicalName="Envoy.ControlPlane.Tests.DeltaCases.json" />
    <EmbeddedResource Include="Fixtures/sotw-stream-cases.json" LogicalName="Envoy.ControlPlane.Tests.StreamCases.json" />
    <EmbeddedResource Include="Fixtures/delta-stream-cases.json" LogicalName="Envoy.ControlPlane.Tests.DeltaStreamCases.json" />
    <EmbeddedResource Include="Fixtures/cache-cases.json" LogicalName="Envoy.ControlPlane.Tests.CacheCases.json" />
    <EmbeddedResource Include="Fixtures/snapshot-cases.json" LogicalName="Envoy.ControlPlane.Tests.SnapshotCases.json" />
    <EmbeddedResource Include="Fixtures/preview-helper-cases.json" LogicalName="Envoy.ControlPlane.Tests.PreviewHelperCases.json" />
    <Compile Include="../../examples/Envoy.ControlPlane.Example/ExampleResources.cs" Link="Support/ExampleResources.cs" />
  </ItemGroup>
</Project>
